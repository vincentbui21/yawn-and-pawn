* text=auto
# Kotlin sources and scripts are LF on every machine (Spotless checks LF).
*.kt text eol=lf
*.kts text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.properties text eol=lf
gradlew text eol=lf
*.bat text eol=crlf
*.jar binary
*.png binary
*.ttf binary
*.otf binary
*.webp binary
*.ogg binary
*.mp3 binary
*.wav binary
