<?xml version="1.0" encoding="utf-8"?>
<!-- Debug build only: the theme showcase (Story 1.3). Release builds never contain it. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Exported without an intent filter so `adb shell am start -n` can open it in debug builds. -->
        <activity
            android:name=".debug.ThemeShowcaseActivity"
            android:exported="true" />
    </application>

</manifest>
