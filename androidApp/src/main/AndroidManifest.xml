<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Exact alarms (AD-4, Story 1.10): USE_EXACT_ALARM on API 33+, SCHEDULE_EXACT_ALARM on API 31-32 only. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <!-- Re-arm every alarm after a reboot (SystemEventsReceiver). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- The wake runtime (Story 1.14, AD-5): the mediaPlayback foreground service, its ongoing notification with a
         full-screen intent, the player's wake lock and the alarm vibration. The editor asks for the notification
         permission once, after the first save (Story 1.19). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".YawnAndPawnApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- Firebase (Story 1.19, AD-15): no auto-start before the first unlock (FirebaseStartup starts it after), and
             no Analytics collection (consent arrives in Epic 5). Crashlytics stays on. -->
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            tools:node="remove" />
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />
        <activity
            android:name=".MainActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The wake screen (AD-5): opened only by the ringing notification's full-screen or content intent, never from
             the background. Its own task, out of Recents, over the lock screen; Back does nothing. -->
        <activity
            android:name=".android.wake.WakeActivity"
            android:directBootAware="true"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:taskAffinity="com.yawnandpawn.app.wake"
            android:turnScreenOn="true"
            tools:targetApi="27" />

        <!-- The wake runtime's foreground service. mediaPlayback [ASSUMPTION pending Spike S2 (systemExempted)]. -->
        <service
            android:name=".android.wake.WakeService"
            android:directBootAware="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Every system alarm the app armed fires here; only the app's own PendingIntents reach it. -->
        <receiver
            android:name=".android.AlarmFiredReceiver"
            android:directBootAware="true"
            android:exported="false" />

        <!-- SPIKE S1 (branch spike/s1-billing-lockscreen only, never merged to main): the lock-screen payment
             prototype, in debug and release. Its own launcher icon "Spike S1" in its own task, also opened by
             yawnandpawn://spike-s1 (adb shell am start -a android.intent.action.VIEW -d yawnandpawn://spike-s1) and by
             the "Ring in 15 s" full-screen notification. -->
        <activity
            android:name=".android.spike.SpikeS1Activity"
            android:exported="true"
            android:label="@string/spike_s1_label"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:taskAffinity="com.yawnandpawn.app.spike"
            android:turnScreenOn="true"
            tools:targetApi="27">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:host="spike-s1"
                    android:scheme="yawnandpawn" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".android.spike.SpikeS1AlarmReceiver"
            android:exported="false" />

        <!-- rescheduleAll() on the system events that clear or shift alarms; all protected system broadcasts. -->
        <receiver
            android:name=".android.SystemEventsReceiver"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
