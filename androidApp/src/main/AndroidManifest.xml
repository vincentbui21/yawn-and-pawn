<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Exact alarms (AD-4, Story 1.10): USE_EXACT_ALARM on API 33+, SCHEDULE_EXACT_ALARM on API 31-32 only. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <!-- Re-arm every alarm after a reboot (SystemEventsReceiver). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- The wake runtime (Story 1.14, AD-5): the mediaPlayback foreground service, its ongoing notification with a
         full-screen intent, the player's wake lock and the alarm vibration. The editor asks for the notification
         permission once, after the first save (Story 1.19). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The QR/Barcode check (Story 3.10): asked only when the user picks it or registers a code (FR-ONB-2), never at
         app start or on the wake screen. Frames are analysed on the device and never stored. The camera is not required,
         so a phone without one can still install the app and use the other checks. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".YawnAndPawnApp"
        android:allowBackup="true"
        android:backupAgent=".android.backup.PpsBackupAgent"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:fullBackupOnly="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- Backup (Story 2.12, NFR-14, AD-6): Auto Backup with PpsBackupAgent (the app.db downgrade guard, re-arming after
             a restore). Restricted mode on every Android version: YawnAndPawnApp (Room, the session restore) never runs
             while a restore replaces app.db. restoreAnyVersion is never set (docs/decisions/db-downgrade.md). -->
        <property
            android:name="android.app.backup.PROPERTY_USE_RESTRICTED_BACKUP_MODE"
            android:value="true" />

        <!-- Firebase (Story 1.19, AD-15): no auto-start before the first unlock (FirebaseStartup starts it after), and
             no Analytics collection (consent arrives in Epic 5). Crashlytics stays on. -->
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            tools:node="remove" />
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />
        <activity
            android:name=".MainActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The wake screen (AD-5): opened only by the ringing notification's full-screen or content intent, never from
             the background. Its own task, out of Recents, over the lock screen; Back does nothing. -->
        <activity
            android:name=".android.wake.WakeActivity"
            android:directBootAware="true"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:taskAffinity="com.yawnandpawn.app.wake"
            android:turnScreenOn="true"
            tools:targetApi="27" />

        <!-- The wake runtime's foreground service. mediaPlayback [ASSUMPTION pending Spike S2 (systemExempted)]. -->
        <service
            android:name=".android.wake.WakeService"
            android:directBootAware="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- The stored alarms and the test alarm fire here; only the app's own PendingIntents reach it. -->
        <receiver
            android:name=".android.AlarmFiredReceiver"
            android:directBootAware="true"
            android:exported="false" />

        <!-- The session slot (Story 2.1): the backup alarm that brings a session back after a kill. Only the app's own
             PendingIntent reaches it. -->
        <receiver
            android:name=".android.SessionSlotReceiver"
            android:directBootAware="true"
            android:exported="false" />

        <!-- rescheduleAll() and the session slot on the system events that clear or shift alarms; all protected system
             broadcasts. LOCKED_BOOT_COMPLETED (Story 2.2) arrives before the first unlock; both databases are
             device-protected, so the slot is armed then. -->
        <receiver
            android:name=".android.SystemEventsReceiver"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
