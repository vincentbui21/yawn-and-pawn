<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon, background layer: the "Sunrise clock" (owner decision 2026-10-29). The 512 x 512 design maps onto
     the whole 108 dp canvas: a night-to-dawn sky and the dark ground below the horizon (y 372). The bells, the sun and
     the hands are in ic_launcher_foreground; StoreGraphicsTest paints both layers for the Play Store icon. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">
    <path android:pathData="M0,0h512v512h-512z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endColor="#FF8A3D0E"
                android:endX="0"
                android:endY="512"
                android:startColor="#FF1F1A17"
                android:startX="0"
                android:startY="0"
                android:type="linear" />
        </aapt:attr>
    </path>
    <path
        android:fillColor="#FF111214"
        android:pathData="M0,372h512v140h-512z" />
</vector>
