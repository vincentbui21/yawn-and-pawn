<resources>
    <!-- Launcher label. In-app text comes from Compose Multiplatform resources in :composeApp. -->
    <string name="app_name">Yawn &amp; Pawn</string>
    <!-- The ringing notification (Story 1.14), verbatim from EXPERIENCE.md > Voice and Tone. -->
    <string name="notification_channel_alarms">Alarms</string>
    <!-- The quiet foreground notification while no alarm shows yet (EXPERIENCE.md "Session in progress"). -->
    <string name="notification_channel_session">Alarm in progress</string>
    <!-- %1$s is the alarm time, formatted for the phone's 12/24-hour setting. -->
    <string name="notification_ringing_text">%1$s alarm · Tap to return to your alarm</string>
    <!-- The weekly summary notification (Story 6.8), verbatim from EXPERIENCE.md > Key strings. %1$d is the number of
         on-time mornings; %s is the amount paid, one per currency joined with " + " (formatted in code, never a symbol here). -->
    <string name="notification_channel_weekly_summary">Weekly summary</string>
    <string name="weekly_summary_nothing_paid">%1$d on-time mornings, nothing paid. Nice.</string>
    <string name="weekly_summary_nothing_paid_one">1 on-time morning, nothing paid. Nice.</string>
    <string name="weekly_summary_paid">%1$d on-time mornings, %2$s paid this week.</string>
    <string name="weekly_summary_paid_one">1 on-time morning, %1$s paid this week.</string>
    <string name="weekly_summary_none">0 on-time mornings this week. Next week\'s a fresh start.</string>
    <!-- The pre-alarm notification (Story 7.11), verbatim from EXPERIENCE.md > Key strings ("Skip next alarm"); the text
         uses the Home countdown wording. %1$s is the alarm time for the phone's 12/24-hour setting; "{time} alarm" as the
         title is the epic's text (EXPERIENCE.md Key strings has none), listed for the owner. -->
    <string name="notification_channel_upcoming_alarms">Upcoming alarms</string>
    <string name="pre_alarm_title">%1$s alarm</string>
    <string name="pre_alarm_rings_in_hours">Rings in %1$d h %2$d min</string>
    <string name="pre_alarm_rings_in_minutes">Rings in %1$d min</string>
    <string name="pre_alarm_skip_action">Skip this one</string>
</resources>
