<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup and device transfer on API 31+ (NFR-14). Only app.db (alarms, later session history) is backed up.
    It lives in device-protected storage, hence the device_database domain. Because there is an <include>,
    everything not included is excluded. runtime.db (the active wake session, Story 1.12) is also excluded
    explicitly in every section, so a later broader include can never pick it up (AD-6). Lint calls an exclude
    outside every include redundant (FullBackupContent); it is ignored on those elements on purpose. runtime.db and
    the DataStore files must never be included. Keep in sync with backup_rules.xml (API 30 and lower); BackupRulesTest checks both.
-->
<data-extraction-rules xmlns:tools="http://schemas.android.com/tools">
    <cloud-backup>
        <include domain="device_database" path="app.db" />
        <exclude domain="device_database" path="runtime.db" tools:ignore="FullBackupContent" />
    </cloud-backup>
    <device-transfer>
        <include domain="device_database" path="app.db" />
        <exclude domain="device_database" path="runtime.db" tools:ignore="FullBackupContent" />
    </device-transfer>
</data-extraction-rules>
