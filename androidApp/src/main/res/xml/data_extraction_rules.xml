<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup and device transfer on API 31+ (NFR-14). Only app.db (alarms, later session history) is backed up.
    It lives in device-protected storage, hence the device_database domain. Because there is an <include>,
    everything not included is excluded. runtime.db (Story 1.12) and DataStore files must never be added here.
    Keep in sync with backup_rules.xml (API 30 and lower); BackupRulesTest checks both.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="device_database" path="app.db" />
    </cloud-backup>
    <device-transfer>
        <include domain="device_database" path="app.db" />
    </device-transfer>
</data-extraction-rules>
