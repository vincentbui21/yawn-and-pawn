<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup and device transfer on API 31+ (NFR-14, AD-6, Story 2.12). Keep in sync with backup_rules.xml (API 30
    and lower). BackupRulesTest checks every entry; BackupRulesCoverageTest fails on any app file that no rule names.

    Backed up, device-protected storage only:
      - app.db: alarms, the request-code mark, session history, and the commitment lock's pending changes and
        commitment events (Story 4.4);
      - datastore/settings.preferences_pb: settings (the base fee and max snoozes, and their pending changes, Story 4.4)
        and the missed-note dismissals.
    Never backed up (excluded explicitly, so a later broader include can never pick them up):
      - runtime.db and its journals: the active wake session (Story 1.12);
      - app.db-journal: the rollback journal (TRUNCATE mode keeps every commit in app.db itself); app.db.lck and
        runtime.db.lck: Room's lock files;
      - wake_runtime.xml: the user's volume saved during a ring; backup_restore.xml: the skipped-restore notice flag;
        reliability.xml: whether the notification permission was asked (Story 2.3), per device, so a new phone asks again;
        settings_fallback.xml: the last-known global settings a fire falls back on (Story 4.4), per device;
      - the whole credential-protected storage (root, file, database, sharedpref), where media will live (Epic 7).
    Because there are includes, anything not included is not backed up either. Lint calls an exclude outside every
    include redundant (FullBackupContent); it is ignored on those elements on purpose.
-->
<data-extraction-rules xmlns:tools="http://schemas.android.com/tools">
    <cloud-backup>
        <include domain="device_database" path="app.db" />
        <include domain="device_file" path="datastore/settings.preferences_pb" />
        <exclude domain="device_database" path="app.db-journal" tools:ignore="FullBackupContent" />
        <exclude domain="device_database" path="app.db.lck" tools:ignore="FullBackupContent" />
        <exclude domain="device_database" path="runtime.db" tools:ignore="FullBackupContent" />
        <exclude domain="device_database" path="runtime.db-journal" tools:ignore="FullBackupContent" />
        <exclude domain="device_database" path="runtime.db-wal" tools:ignore="FullBackupContent" />
        <exclude domain="device_database" path="runtime.db-shm" tools:ignore="FullBackupContent" />
        <exclude domain="device_database" path="runtime.db.lck" tools:ignore="FullBackupContent" />
        <exclude domain="device_sharedpref" path="wake_runtime.xml" tools:ignore="FullBackupContent" />
        <exclude domain="device_sharedpref" path="backup_restore.xml" tools:ignore="FullBackupContent" />
        <exclude domain="device_sharedpref" path="reliability.xml" tools:ignore="FullBackupContent" />
        <exclude domain="device_sharedpref" path="settings_fallback.xml" tools:ignore="FullBackupContent" />
        <exclude domain="root" path="." tools:ignore="FullBackupContent" />
        <exclude domain="file" path="." tools:ignore="FullBackupContent" />
        <exclude domain="database" path="." tools:ignore="FullBackupContent" />
        <exclude domain="sharedpref" path="." tools:ignore="FullBackupContent" />
    </cloud-backup>
    <device-transfer>
        <include domain="device_database" path="app.db" />
        <include domain="device_file" path="datastore/settings.preferences_pb" />
        <exclude domain="device_database" path="app.db-journal" tools:ignore="FullBackupContent" />
        <exclude domain="device_database" path="app.db.lck" tools:ignore="FullBackupContent" />
        <exclude domain="device_database" path="runtime.db" tools:ignore="FullBackupContent" />
        <exclude domain="device_database" path="runtime.db-journal" tools:ignore="FullBackupContent" />
        <exclude domain="device_database" path="runtime.db-wal" tools:ignore="FullBackupContent" />
        <exclude domain="device_database" path="runtime.db-shm" tools:ignore="FullBackupContent" />
        <exclude domain="device_database" path="runtime.db.lck" tools:ignore="FullBackupContent" />
        <exclude domain="device_sharedpref" path="wake_runtime.xml" tools:ignore="FullBackupContent" />
        <exclude domain="device_sharedpref" path="backup_restore.xml" tools:ignore="FullBackupContent" />
        <exclude domain="device_sharedpref" path="reliability.xml" tools:ignore="FullBackupContent" />
        <exclude domain="device_sharedpref" path="settings_fallback.xml" tools:ignore="FullBackupContent" />
        <exclude domain="root" path="." tools:ignore="FullBackupContent" />
        <exclude domain="file" path="." tools:ignore="FullBackupContent" />
        <exclude domain="database" path="." tools:ignore="FullBackupContent" />
        <exclude domain="sharedpref" path="." tools:ignore="FullBackupContent" />
    </device-transfer>
</data-extraction-rules>
